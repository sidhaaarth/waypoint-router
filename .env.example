# Copy to .env and fill in. All optional: each user brings their own Token Factory key at sign-up.

# Tavily: look-ups on trusted help-centre sites, starter packs
TAVILY_API_KEY=

# LangSmith tracing of every Token Factory call
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=waypoint

# Router settings
# DB_PATH=router.db
# ROUTER_SECRET=          # Fernet key; generated next to the DB if unset
# PORT=8888
